rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Photos de repas : lecture/écriture par le propriétaire uniquement
    match /repas-photos/{uid}/{filename} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Tout le reste : refusé
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
