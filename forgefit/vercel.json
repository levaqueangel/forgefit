{
  "crons": [
    {
      "path": "/api/cron/relance-j7",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/recap-j28",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/relance-abandon",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/checkin-hebdo",
      "schedule": "0 9 * * 1"
    }
  ],
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}